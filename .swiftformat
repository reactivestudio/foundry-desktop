# SwiftFormat — форматтер исходников (аналог google-java-format / Prettier).
# Установка:  brew install swiftformat
# Формат:     swiftformat .
# Проверка:   swiftformat --lint .      (CI: падает, если что-то не отформатировано)
#
# Конфиг намеренно консервативен: инвариант проекта — ноль визуальных изменений,
# а вёрстка кода местами выстроена вручную (Metal-математика, длинные токен-цепочки).
# Массовый rewrap отключён, чтобы прогон не переписал пол-репозитория.

--swiftversion 6.1
--indent 4
--maxwidth none          # не переносим по ширине — вёрстка строк ручная
--wraparguments preserve
--wrapparameters preserve
--wrapcollections preserve
--self remove            # SwiftUI-идиома: без лишнего self.
--stripunusedargs closure-only
--commas inline
--trailingclosures

# Отключаем самые инвазивные правила — они дают шумный дифф без пользы:
--disable blankLinesAtStartOfScope, blankLinesAtEndOfScope, wrapMultilineStatementBraces

# Генерат не трогаем; .build и scratchpad вне области.
--exclude .build,Packages/FoundryKit/.build,Packages/FoundryKit/scratchpad,Packages/FoundryKit/Sources/FoundryFeatures/DesignTokens.swift
